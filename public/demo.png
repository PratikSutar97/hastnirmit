python3 - <<'PY'
import struct, zlib

width, height = 600, 200
raw = b''.join(
    b'\x00' + bytes([248, 243, 233]) * width
    for _ in range(height)
)

def chunk(name, data):
    return (
        struct.pack(">I", len(data)) +
        name + data +
        struct.pack(">I", zlib.crc32(name + data) & 0xffffffff)
    )

png = (
    b'\x89PNG\r\n\x1a\n' +
    chunk(b'IHDR', struct.pack(">2I5B", width, height, 8, 2, 0, 0, 0)) +
    chunk(b'IDAT', zlib.compress(raw)) +
    chunk(b'IEND', b'')
)

with open("public/demo.png", "wb") as f:
    f.write(png)

print("Created public/demo.png")
PY